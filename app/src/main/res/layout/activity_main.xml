<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="20dp">

    <!-- Header Judul -->
    <TextView
        android:id="@+id/tvMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Ikon Gear Pengaturan di Pojok Kanan Atas (Diperbesar) -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu_title_settings"
        android:padding="6dp"
        android:scaleType="fitCenter" />

    <!-- Tombol Utama Buka / Tutup Floating Clock -->
    <Button
        android:id="@+id/btnToggleFloating"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_primary"
        android:stateListAnimator="@null"
        android:text="@string/open_floating"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Tombol Fitur Kontrol (Device Time Statis, Presisi MS & Statistik) -->
    <LinearLayout
        android:id="@+id/llQuickActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnToggleFloating"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnToggleSource"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:clickable="false"
            android:focusable="false"
            android:stateListAnimator="@null"
            android:text="@string/device_time"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnToggleMetrics"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:stateListAnimator="@null"
            android:text="@string/metrics_on"
            android:textAllCaps="false"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Area Tengah Lingkaran Jam Interaktif (Digital / Analog Switch) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/llQuickActions"
        android:layout_below="@id/btnSettings">

        <FrameLayout
            android:id="@+id/cardClockCircle"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_dial">

            <!-- Kontainer Jam Digital -->
            <LinearLayout
                android:id="@+id/layoutDigitalClock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMainTimeHms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="01:29:25."
                        android:textColor="@color/text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMainTimeMillis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="3"
                        android:textColor="@color/text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tanggal & Tahun Berjalan -->
                <TextView
                    android:id="@+id/tvMainDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Friday, 20/11/2026"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMainTimeSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/device_time"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Kontainer Jam Analog Quartz -->
            <View
                android:id="@+id/viewAnalogClock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

</RelativeLayout>
